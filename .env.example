# ==============================================================================
# PhishShield AI - Environment Variables & Supabase Configuration
# ==============================================================================

# Server Network Configuration
PORT=5050
NODE_ENV=development

# JWT Secret for Session Authentication & API Keys
JWT_SECRET=phishshield_super_secure_jwt_secret_capstone_2026_!@#$

# ------------------------------------------------------------------------------
# Supabase Cloud Database Configuration
# ------------------------------------------------------------------------------
# 1. Sign up / log in to https://supabase.com
# 2. Create a new project (e.g., "phishshield-ai")
# 3. Go to Project Settings -> API
# 4. Copy your Project URL and anon public / service_role keys here:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Provider: 'supabase' (uses Supabase Cloud DB) or 'local' (offline JSON DB)
# If SUPABASE_URL is provided, 'supabase' is activated automatically.
DB_PROVIDER=supabase
